# Copy to .env.local (gitignored). Only the anon/publishable key belongs here, never service_role.
# Both values are optional: without them the app runs in guest mode (tools work, accounts are off).
VITE_SUPABASE_URL=https://jzpyoyjnhuokprsdoiqf.supabase.co
VITE_SUPABASE_ANON_KEY=

# Telemetry (optional): without the Sentry and PostHog keys telemetry stays
# off and the app works normally. SENTRY_AUTH_TOKEN is only for CI builds
# that upload source maps; it must never be committed.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_APP_VERSION=dev
# Set to true to test Sentry and PostHog locally in `npm run dev`.
VITE_TELEMETRY_IN_DEV=false

# Image posts (optional): "true" shows the image composer and feed images.
# Everything else hides the feature. Leave off until the buckets, the
# screen-image Edge Function and img.ohkolab.com are set up.
VITE_IMAGE_POSTS=false
